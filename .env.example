# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Resend — https://resend.com/api-keys (optional; welcome emails are skipped if unset)
RESEND_API_KEY=
# Optional: verified sender. Defaults to Resend's shared onboarding address.
EMAIL_FROM="UpStartMBA <onboarding@resend.dev>"

# The canonical URL of the deployed app (used in emails and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
